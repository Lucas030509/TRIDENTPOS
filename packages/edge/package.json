{
  "name": "@trident/edge",
  "version": "0.1.0",
  "description": "TRIDENTPOS Edge Host Layer Scaffolding",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@trident/core": "*"
  },
  "scripts": {
    "build": "tsc -b && node -e \"import('node:fs').then(fs => { fs.copyFileSync('src/index.html', 'dist/index.html'); fs.copyFileSync('src/preload.cjs', 'dist/preload.cjs'); })\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test:unit": "node --test dist/index.test.js",
    "test:electron": "node scripts/run-electron-tests.mjs",
    "test": "npm run test:unit && npm run test:electron",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "electron": "44.3.0"
  }
}
