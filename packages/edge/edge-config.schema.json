{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EdgeRuntimeConfig",
  "description": "Non-sensitive metadata configuration for TRIDENTPOS Edge Host runtime. Secret-bearing storage is strictly prohibited.",
  "type": "object",
  "required": ["version", "environment", "station", "network", "logging"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "environment": {
      "type": "string",
      "enum": ["development", "staging", "production", "test"]
    },
    "station": {
      "type": "object",
      "required": ["code", "stationType", "name"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "stationType": {
          "type": "string",
          "enum": ["POS", "KDS", "CAPTAIN", "MANAGER"]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "network": {
      "type": "object",
      "required": ["host", "port"],
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        }
      }
    },
    "logging": {
      "type": "object",
      "required": ["level"],
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"]
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 800,
          "maximum": 3840
        },
        "height": {
          "type": "integer",
          "minimum": 600,
          "maximum": 2160
        },
        "title": {
          "type": "string",
          "maxLength": 100
        }
      }
    }
  }
}
