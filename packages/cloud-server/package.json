{
  "name": "@trident/cloud-server",
  "version": "0.1.0",
  "description": "TRIDENTPOS Cloud Server Composition Root & Application Services",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@trident/billing": "*",
    "@trident/core": "*",
    "@trident/database": "*",
    "@trident/finance": "*",
    "@trident/inventory": "*",
    "@trident/procurement": "*",
    "dotenv": "^16.4.7",
    "pg": "8.13.3"
  },
  "devDependencies": {
    "@types/pg": "8.11.11"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "node --test --test-concurrency=1 dist/index.test.js dist/billing.test.js",
    "clean": "rm -rf dist"
  }
}
