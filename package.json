{
  "name": "tridentpos",
  "version": "0.1.0",
  "description": "TRIDENTPOS Monorepo Foundation",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "graph:check": "node scripts/check-graph.mjs",
    "format:check": "prettier --check \"packages/**/*.{ts,js,json}\" \"scripts/**/*.{js,mjs}\" \"*.{json,cjs,mjs}\"",
    "format": "prettier --write \"packages/**/*.{ts,js,json}\" \"scripts/**/*.{js,mjs}\" \"*.{json,cjs,mjs}\"",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "~5.4.5"
  }
}
